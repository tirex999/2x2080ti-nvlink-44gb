+# page that is already on its node alone; a page is placed by the row its first byte belongs to.
+_NUMA_BLK = 32
+_NUMA_ROW_BANKS = {"gate_up_packed": "gu", "gate_up_scale": "gu", "gate_up": "gu",
+                   "down_packed": "dn", "down_scale": "dn", "down": "dn"}
+_numa_nodes_cache = False
+_numa_totals = {"banks": 0, "pages": 0, "bytes_node": [0, 0], "misplaced": 0, "seconds": 0.0}
+_numa_lock = threading.Lock()
+
+
+def numa_enabled() -> bool:
+    return os.environ.get("FT_NUMA", "").strip().lower() in ("1", "true", "yes", "on")
+
+
+def numa_nodes() -> list[int] | None:
+    """The two NUMA nodes of this process's CPUs (ascending), or None: one node, more than two, or no sysfs."""
+    global _numa_nodes_cache
+    if _numa_nodes_cache is False:
