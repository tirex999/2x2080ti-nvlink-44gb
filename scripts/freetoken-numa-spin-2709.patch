+    return _numa_nodes_cache
+
+
+def numa_split(n: int) -> int:
+    """How many of n output rows node group 0 owns: the first half of the 32-row blocks (= numa_splits() in C++)."""
+    nb = (n + _NUMA_BLK - 1) // _NUMA_BLK
+    return min(n, (nb // 2) * _NUMA_BLK)
+
+
+def numa_summary() -> str:
+    t = _numa_totals
+    if not t["banks"]:
+        return "no bank placed"
+    return (f"{t['banks']} banks, {t['bytes_node'][0] / 2**30:.1f} GiB on the first node and "
+            f"{t['bytes_node'][1] / 2**30:.1f} GiB on the second, {t['misplaced']} pages left elsewhere, "
+            f"{t['seconds']:.1f} s of move_pages")
+
+
+def _numa_move(bank: "HostBank") -> None:
+    """Move a filled, not yet pinned row bank's pages to the node of their rows (see above)."""
+    if bank._numa is None or not numa_enabled():
+        return
+    nodes = numa_nodes()
+    if not nodes:
+        return
+    import numpy as np
+
+    kind, rows, row_bytes = bank._numa
+    t0 = time.perf_counter()
+    page = mmap.PAGESIZE
+    npages = (bank.nbytes + page - 1) // page
+    off = np.arange(npages, dtype=np.int64) * page
+    r = (off // row_bytes) % rows              # the row of the page's first byte, within its expert
+    if kind == "gu":                           # [gate rows 0..I) + [up rows I..2I), row i and I+i together
+        half = rows // 2
+        grp = (r % half) >= numa_split(half)
+    else:                                      # down rows 0..H
+        grp = r >= numa_split(rows)
+    target = np.where(grp, nodes[1], nodes[0]).astype(np.int32)
+    addrs = (off + bank.addr).astype(np.uint64)
+    status = np.empty(npages, dtype=np.int32)
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.syscall.restype = ctypes.c_long
+    step = 1 << 16
+    for i in range(0, npages, step):
+        j = min(i + step, npages)
+        # move_pages(0 = self, count, pages, nodes, status, MPOL_MF_MOVE); x86_64 syscall 279
+        rc = libc.syscall(ctypes.c_long(279), ctypes.c_long(0), ctypes.c_ulong(j - i),
+                          ctypes.c_void_p(addrs[i:j].ctypes.data), ctypes.c_void_p(target[i:j].ctypes.data),
+                          ctypes.c_void_p(status[i:j].ctypes.data), ctypes.c_long(2))
+        if rc < 0:
+            err = ctypes.get_errno()
+            logger.warning(f"numa: move_pages failed ({os.strerror(err)}); bank left where it is")
+            return
+    placed = status == target
+    with _numa_lock:
+        t = _numa_totals
+        t["banks"] += 1
+        t["pages"] += npages
+        t["bytes_node"][0] += int(np.count_nonzero(placed & (target == nodes[0]))) * page
+        t["bytes_node"][1] += int(np.count_nonzero(placed & (target == nodes[1]))) * page
+        t["misplaced"] += int(npages - np.count_nonzero(placed))
+        t["seconds"] += time.perf_counter() - t0
