# Лучшее, что удалось выжать из Qwen3.8-27B: 64.2 / 79.7 / 73.8.
# Веса 19 ГБ против 29.5 у INT8 — на карту ложится вдвое легче, под KV
# остаётся больше, поэтому берём полный контекст 131072.
# int8 KV-cache НЕ включаем: замерено 11.07, он вредит скорости.
SERVED_NAME=qwen38awq
COMPATIBLE_MODES=normal
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-awq
MODEL_VARIANT=int4
QUANTIZATION=compressed-tensors
MAX_MODEL_LEN=131072
GPU_UTIL=0.94
MTP_K=4
MAX_NUM_SEQS=2
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
