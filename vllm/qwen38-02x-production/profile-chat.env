# Боевой профиль ЧАТА. От замерного awq-k4.env отличается двумя строками.
# MAX_NUM_SEQS=1 — потому что батч больше единицы вместе с MTP и CUDA-графом
# роняет сервер на sm_75 (illegal memory access). Замерный профиль остаётся
# зеркалом рабочего с 0.1.14, иначе сравнение веток движка теряет смысл.
SERVED_NAME=qwen38awq
COMPATIBLE_MODES=normal
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-awq
MODEL_VARIANT=int4
QUANTIZATION=compressed-tensors
MAX_MODEL_LEN=131072
GPU_UTIL=0.94
MTP_K=4
MAX_NUM_SEQS=1
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
DISABLE_LOG_STATS=0
