[Unit]
# Ограниченный перезапуск: с Restart=on-failure
RestartSec=30 упавший сервер лежит молча.
StartLimitIntervalSec=3600
StartLimitBurst=3
Description=vLLM 0.2.1-pre3, Qwen3.8-27B AWQ-MTP
After=network-online.target

[Service]
# Type=forking ОБЯЗАТЕЛЬНО: лаунчер 0.2.x демонизирует сервер и выходит.
# При Type=simple systemd убивает всю группу сразу после smoke-теста.
Type=forking
PIDFile=/root/vllm-0.2.x/run-logs/vllm-qwen38awq.pid
Environment=HOME=/root
Environment=MODEL_DIR=/LLM/models/vllm-ready/twolven-Qwen3.8-27B-AWQ-MTP
# Боевой профиль ЧАТА: MAX_NUM_SEQS=1. Батч больше единицы вместе с MTP
# и CUDA-графом роняет сервер (см. docs/pitfalls.md). Замерный профиль
# awq-k4.env остаётся нетронутым.
Environment=PROFILE=qwen38awq/user/awq-k4-chat.env
Environment=MODE=normal
Environment=PORT=8000
Environment=SERVICE_SCOPE=lan
Environment=TP_SIZE=2
# Без этих двух Open WebUI получает отказ на tool_choice=auto.
# Ключи ГЛОБАЛЬНЫЕ (profile_key_is_global в лаунчере) — их место здесь,
# а не в профиле кванта: профиль остаётся зеркалом рабочего.
# Парсер выбран по шаблону чата модели, подробности в docs/pitfalls.md.
Environment=ENABLE_AUTO_TOOL_CHOICE=1
Environment=TOOL_CALL_PARSER=qwen3_xml
# Статистика токенов в каждом потоковом ответе: Open WebUI её
# обрабатывает, но не запрашивает. Требует строки в лаунчере.
Environment=FORCE_INCLUDE_USAGE=1
Environment=CUDA_VISIBLE_DEVICES=0,1
Environment=CUDA_HOME=/usr/local/cuda-13.0
Environment=PATH=/usr/local/cuda-13.0/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /root/vllm-0.2.x/launcher.sh --non-interactive
TimeoutStartSec=1800
KillMode=mixed
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
