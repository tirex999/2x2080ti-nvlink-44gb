# Восьмибитный INT8 W8A16 с MTP. Замер: 47.5 / 55.1 / 50.9 — на 40% медленнее
# четырёхбитного AWQ. На Turing (SM75) путь INT8 не оптимизирован; отдельный
# замер Quark-INT8 W8A8 дал вообще 15.7 против 113 у AWQ.
# Веса 29.5 ГБ, поэтому контекст урезан: под KV остаётся меньше места
# (на 131072 нужно 4.74 ГиБ, доступно 4.26 — движок сам считает предел 115872).
SERVED_NAME=qwen38
COMPATIBLE_MODES=normal
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-int8
MODEL_VARIANT=int8
QUANTIZATION=compressed-tensors
MAX_MODEL_LEN=98304
GPU_UTIL=0.93
MTP_K=4
MAX_NUM_SEQS=2
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
