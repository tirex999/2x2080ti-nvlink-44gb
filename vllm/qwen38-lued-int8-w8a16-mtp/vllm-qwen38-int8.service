[Unit]
Description=vLLM qwen38-lued-int8-w8a16-mtp
After=network-online.target

[Service]
Type=simple
Environment=HOME=/root
Environment=MODEL_DIR=/LLM/models/vllm-ready/lued-Qwen3.8-27B-INT8-W8A16-MTP
# ПУТЬ ЦЕЛИКОМ от каталога profiles/ — короткое имя молча уводит лаунчер
# в чужой автоподбор.
Environment=PROFILE=qwen38/user/int8-k4.env
Environment=MODE=normal
Environment=PORT=8000
Environment=SERVICE_SCOPE=lan
Environment=CUDA_VISIBLE_DEVICES=0,1
Environment=CUDA_HOME=/usr/local/cuda-12.8
Environment=PATH=/usr/local/cuda-12.8/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /root/vllm-0.1.14/launcher.sh --non-interactive
Restart=no

[Install]
WantedBy=multi-user.target
