# Свой квант Qwen3.8-27B по рецепту чемпиона QuantTrio.
# 4 бита, группа 128, симметричный, actorder=null (нет g_idx, значит Marlin
# работает на полной скорости). НЕ квантованы: self_attn.q/k/v_proj,
# linear_attn.in_proj_a/b, весь layers.0, mtp, lm_head, visual.
# Проверял ровно одно: рецепт ли отвечает за разрыв 80 против 92.
# Замер: 57.8 / 69.0 / 71.6 — хуже готового twolven. Гипотеза опровергнута.
SERVED_NAME=ownq38
COMPATIBLE_MODES=normal
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-own-gptq
MODEL_VARIANT=int4
QUANTIZATION=compressed-tensors
MAX_MODEL_LEN=131072
GPU_UTIL=0.94
MTP_K=4
MAX_NUM_SEQS=2
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
