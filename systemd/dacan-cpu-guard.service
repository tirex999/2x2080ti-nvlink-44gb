[Unit]
Description=DACAN CPU guard: VM 105 yields cores while CT 200 (DACAN) is answering
After=pve-guests.service

[Service]
EnvironmentFile=-/etc/default/dacan-cpu-guard
ExecStart=/usr/local/sbin/dacan-cpu-guard.sh
ExecStopPost=/bin/sh -c 'f=/sys/fs/cgroup/qemu.slice/105.scope/cpu.max; [ -f $f ] && echo "max 100000" > $f || true'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
