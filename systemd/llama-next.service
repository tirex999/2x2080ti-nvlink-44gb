[Unit]
Description=llama.cpp Qwen3.8-Flash-Next
After=network-online.target

[Service]
Type=simple
Environment=HOME=/root
# Без этого сервер падает при загрузке MTP-головы: поворот активаций для
# квантованного KV не поддержан путём qwen4exp.
Environment=LLAMA_ATTN_ROT_DISABLE=1

# Команда вынесена в скрипт намеренно: systemd портит обратные слэши прямо
# в ExecStart ("Ignoring unknown escape sequences"), а в правилах -ot они
# несут смысл.
ExecStart=/bin/bash /root/run-next.sh

Restart=no
TimeoutStopSec=90

# Обязательно. Иначе mlock молча не сработает, и модель поедет через mmap
# с сетевого хранилища — это 0.07 t/s вместо рабочих цифр.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
